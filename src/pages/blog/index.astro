---
import Layout from "../../layouts/Layout.astro";
import BackLink from "../../components/BackLink.astro";
import { SITE } from "../../site-config";

export const prerender = true;
---

<Layout
  description={`${SITE.author.fullName} - Blog & Notes`}
  title={`${SITE.author.fullName} - Blog`}
>
  <main
    class="w-full min-h-screen flex flex-col justify-start items-start max-w-3xl mx-auto p-8 text-white"
  >
    <BackLink href="/" class="mb-8" />
    <h1 class="text-4xl font-bold mb-4 text-neutral-100">
      <span class="lang-en">Blog & Notes</span>
      <span class="lang-fa">وبلاگ و یادداشت‌ها</span>
    </h1>
    <p class="text-darkslate-300 text-sm">
      <span class="lang-en">
        New articles and project case studies will be shared here soon.
      </span>
      <span class="lang-fa">
        به زودی یادداشت‌ها، مقالات و روند شکل‌گیری پروژه‌ها در این بخش قرار می‌گیرد.
      </span>
    </p>
  </main>
</Layout>
