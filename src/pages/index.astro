---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card/index.astro";
import IntroCard from "../components/IntroCard.astro";
import ContactsCard from "../components/ContactsCard.astro";
import ThemeChangeCard from "../components/ThemeChangeCard.astro";
import TimeZone from "../components/TimeZoneCard.astro";
import AboutMe from "../components/AboutMe.astro";
import Now from "../components/Now.astro";
import DesignWorksCard from "../components/DesignWorksCard.astro";
import PixelHeart from "../components/PixelHeart.astro";
import { SITE } from "../site-config";

export const prerender = true;
---

<script>
  import { initHomeEntrance } from "../lib/home-entrance";
  initHomeEntrance();
</script>

<script>
  import { initCardGrids } from "../lib/card-grids";
  initCardGrids();
</script>

<Layout
  description={`${SITE.author.fullName} - ${SITE.author.jobTitle}`}
  title={`${SITE.author.fullName} | ${SITE.author.jobTitle}`}
>
  <main
    class="text-white m-auto p-2 grid gap-2 max-w-6xl overflow-x-hidden relative w-full sm:p-4 sm:gap-2 md:grid-cols-2 md:gap-3 md:p-6 lg:h-[max(100dvh,720px)] lg:grid-rows-8 lg:grid-cols-4 lg:gap-4"
  >
    <IntroCard />
    <AboutMe />
    <ContactsCard />
    <TimeZone />
    <DesignWorksCard />
    <Now />

    <Card href="/animation-concept" colSpan="md:col-span-1" rowSpan="md:row-span-1">
      <div slot="background" class="absolute inset-0 -z-10 overflow-hidden">
        <div id="playground-grid" class="absolute inset-0"></div>
      </div>
      <div class="flex-1 flex items-center">
        <h2 class="text-xl md:text-2xl lg:text-xl font-bold m-0">
          <span class="lang-en">Animation Concept</span>
          <span class="lang-fa">کانسپت انیمیشن</span>
        </h2>
      </div>
    </Card>

    <Card
      href="/animation"
      colSpan="md:col-span-1 w-full"
      rowSpan="md:row-span-1"
      prefetch="viewport"
    >
      <div
        slot="background"
        id="guestbook-grid"
        class="absolute inset-0 overflow-hidden pointer-events-none"
        aria-hidden="true"
      >
      </div>
      <div class="flex-1 flex items-center">
        <h2 class="text-xl md:text-2xl lg:text-xl font-bold m-0">
          <span class="lang-en">Animation</span>
          <span class="lang-fa">انیمیشن</span>
        </h2>
      </div>
    </Card>

    <Card href="/blog" colSpan="md:col-span-1" rowSpan="md:row-span-1">
      <div
        slot="background"
        id="blog-bg"
        class="absolute inset-0 overflow-hidden pointer-events-none"
        aria-hidden="true"
      >
      </div>
      <div class="flex-1 flex items-center">
        <h2 class="text-xl md:text-2xl lg:text-xl font-bold m-0">
          <span class="lang-en">Blog</span>
          <span class="lang-fa">وبلاگ و یادداشت‌ها</span>
        </h2>
      </div>
    </Card>

    <ThemeChangeCard />

    <Card colSpan="md:col-span-1" rowSpan="md:row-span-1">
      <div class="flex h-full items-center justify-center">
        <p class="text-3xs text-center whitespace-nowrap">
          <span class="lang-en">
            © {new Date().getFullYear()} · Crafted with <PixelHeart /> by{" "}
            <span class="text-primary-400 font-bold">{SITE.author.fullName}</span>
          </span>
          <span class="lang-fa">
            © {new Date().getFullYear()} · طراحی و ساخت با <PixelHeart /> توسط{" "}
            <span class="text-primary-400 font-bold">{SITE.author.fullNameFa}</span>
          </span>
        </p>
      </div>
    </Card>
  </main>
</Layout>
