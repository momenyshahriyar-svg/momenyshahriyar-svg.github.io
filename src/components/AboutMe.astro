---
import Card from "./Card/index.astro";

const stack = [
  {
    groupEn: "Specialties & Roles",
    groupFa: "تخصص‌ها و زمینه‌های فعالیت",
    itemsEn: [
      "Character Design",
      "Concept Design",
      "Storyboard Design",
      "Art Direction",
      "2D Animation",
      "2D Game Art",
      "AI Art",
    ],
    itemsFa: [
      "طراحی کاراکتر",
      "طراحی کانسپت",
      "طراحی استوری‌بورد",
      "کارگردانی هنری",
      "انیمیشن دوبعدی",
      "گرافیک بازی دوبعدی",
      "هنر هوش مصنوعی",
    ],
  },
  {
    groupEn: "Illustration & Painting",
    groupFa: "تصویرسازی و طراحی دیجیتال",
    itemsEn: ["Adobe Photoshop", "Adobe Illustrator", "Krita", "Aseprite"],
    itemsFa: ["Adobe Photoshop", "Adobe Illustrator", "Krita", "Aseprite"],
  },
  {
    groupEn: "Animation & Storyboard",
    groupFa: "انیمیشن و استوری‌بورد",
    itemsEn: ["Adobe Animate", "Toon Boom Storyboard Pro"],
    itemsFa: ["Adobe Animate", "Toon Boom Storyboard Pro"],
  },
  {
    groupEn: "Game Development",
    groupFa: "توسعه و ساخت بازی",
    itemsEn: ["Godot Engine"],
    itemsFa: ["Godot Engine"],
  },
  {
    groupEn: "Education",
    groupFa: "تحصیلات دانشگاهی",
    itemsEn: ["M.A. & B.A. in Graphic Design — Isfahan University of Art"],
    itemsFa: ["کارشناسی و کارشناسی ارشد ارتباط تصویری (گرافیک) — دانشگاه هنر اصفهان"],
  },
];

const CHIP =
  "text-2xs px-2 py-0.5 rounded-full border border-darkslate-400 text-darkslate-100 hover:border-primary-500 hover:text-white transition-colors duration-150";
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-6"
  title="About & Skills"
  titleFa="درباره من و مهارت‌ها"
  class="pad-lg"
>
  <div class="flex flex-col gap-3 mt-2">
    {
      stack.map(({ groupEn, groupFa, itemsEn, itemsFa }) => (
        <div class="flex flex-col gap-1.5">
          <span class="text-3xs uppercase tracking-wider text-darkslate-300">
            <span class="lang-en">{groupEn}</span>
            <span class="lang-fa">{groupFa}</span>
          </span>
          <div class="flex flex-wrap gap-1.5 lang-en">
            {itemsEn.map((label) => (
              <span class={CHIP}>{label}</span>
            ))}
          </div>
          <div class="flex flex-wrap gap-1.5 lang-fa">
            {itemsFa.map((label) => (
              <span class={CHIP}>{label}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Card>
