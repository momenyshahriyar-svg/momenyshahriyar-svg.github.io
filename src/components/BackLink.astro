---
interface Props {
  href?: string;
  class?: string;
  label?: string;
  labelFa?: string;
}

const {
  href = "/",
  class: extraClass = "",
  label = "Back to Home",
  labelFa = "بازگشت به صفحه اصلی",
} = Astro.props;
---

<span class:list={["btn-shell btn-shell--flat inline-flex w-fit", extraClass]}>
  <a
    href={href}
    class="btn--ns btn-chrome inline-flex items-center w-fit px-4 py-2 rounded-lg text-sm"
  >
    <span class="lang-en">← {label}</span>
    <span class="lang-fa">→ {labelFa}</span>
  </a>
</span>
