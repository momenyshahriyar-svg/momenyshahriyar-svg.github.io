---
import Card from "./Card/index.astro";
import Button from "./Button.astro";
import { Icon } from "astro-icon/components";
import Tooltip from "./Tooltip/index";
import { SITE } from "../site-config";
import AvatarSprite from "./AvatarSprite.astro";
---

<Card colSpan="md:col-span-3" rowSpan="md:row-span-4" class="pad-lg">
  <div class="flex w-full h-full items-center justify-between gap-4">
    <div class="flex flex-col justify-between gap-4 flex-1">
      <div class="flex flex-col h-full">
        <h6 class="text-sm font-light m-0 text-darkslate-300">
          <span class="lang-en">welcome</span>
          <span class="lang-fa">خوش آمدید</span>
        </h6>

        <div class="lang-en">
          <p class="m-0 font-light text-base leading-relaxed mt-1">
            <span>
              Hi, I'm <b class="font-bold text-white">{SITE.author.fullName}</b> — an{" "}
              <b class="font-bold text-primary-400">{SITE.author.jobTitle}</b>.
            </span>
            <span class="block mt-3">
              This page showcases some of my work and provides more information
              about me. I’m not usually very good at keeping things up to date,
              but I’ve made an effort to share some of my projects here.
            </span>
            <span class="block mt-3 text-darkslate-200 text-sm">
              I studied Graphic Design at the Isfahan University of Art, where I
              am currently pursuing a Master’s degree. At present, I specialize
              in character design, concept art, storyboarding, and art direction
              for 2D animation and game production projects.
            </span>
          </p>
        </div>

        <div class="lang-fa">
          <p class="m-0 font-light text-base leading-relaxed mt-1">
            <span>
              سلام، من <b class="font-bold text-white">{SITE.author.fullNameFa}</b> هستم؛{" "}
              <b class="font-bold text-primary-400">{SITE.author.jobTitleFa}</b>.
            </span>
            <span class="block mt-3">
              در این صفحه گزیده‌ای از آثار و اطلاعات بیشتری درباره من قرار دارد.
              معمولاً در به‌روز نگه داشتن کارها چندان منظم نیستم، اما تلاش کرده‌ام
              بخشی از پروژه‌هایم را در اینجا با شما به اشتراک بگذارم.
            </span>
            <span class="block mt-3 text-darkslate-200 text-sm">
              من فارغ‌التحصیل رشته طراحی گرافیک از دانشگاه هنر اصفهان هستم و هم‌اکنون
              مقطع کارشناسی ارشد را در همین دانشگاه دنبال می‌کنم. در حال حاضر در
              زمینه طراحی کاراکتر، طراحی کانسپت، استوری‌بورد و کارگردانی هنری برای
              پروژه‌های تولید انیمیشن دوبعدی و بازی فعالیت می‌کنم.
            </span>
          </p>
        </div>
      </div>

      <div class="flex flex-col lg:flex-row gap-2 lg:gap-4 mt-2">
        <div class="flex gap-2 lg:gap-4 items-center">
          <a
            href={SITE.links.telegram}
            aria-label="Telegram profile"
            target="_blank"
          >
            <Button aria-label="Telegram profile">
              <Icon name="pixel-telegram" class="w-4 h-4" />
              <span class="sr-only">Telegram Profile</span>
            </Button>
          </a>
          <a
            href={SITE.links.instagram}
            aria-label="Instagram profile"
            target="_blank"
          >
            <Button aria-label="Instagram profile">
              <Icon name="pixel-instagram" class="w-4 h-4" />
              <span class="sr-only">Instagram Profile</span>
            </Button>
          </a>
          <Tooltip client:visible>
            <Button aria-label="easter egg btn">
              <Icon name="pixel-laugh" />
              <span class="sr-only">Easter egg button</span>
            </Button>
          </Tooltip>
        </div>
      </div>
    </div>
    <div
      id="memoji-spin-area"
      class="contents md:flex md:flex-col md:items-center md:pb-3 md:select-none md:touch-pan-y md:cursor-[var(--cursor-rotate)]"
    >
      <AvatarSprite
        id="memoji-avatar"
        themed
        levitate
        spinOnReveal
        height="250px"
        label={`avatar of ${SITE.author.firstName}, slowly rotating`}
        class="select-none absolute right-[-110px] bottom-[-20px] z-[-1] opacity-50 md:opacity-100 md:relative md:right-auto md:bottom-auto md:z-auto pointer-events-none md:pointer-events-auto"
      />
      <Icon
        name="pixel-rotate"
        aria-hidden="true"
        class="hidden md:block w-[26px] h-auto mt-4 text-darkslate-300 opacity-40"
      />
    </div>
  </div>
</Card>

<script>
  import {
    cellPosition,
    DEFAULT_SHEET,
    SHEET_BY_THEME,
    SPRITE,
  } from "../lib/avatar-sprite.mjs";

  const PX_PER_FRAME = 14;

  const sheetFor = (theme: string | null): string =>
    SHEET_BY_THEME[theme ?? "default"] ?? DEFAULT_SHEET;

  const decoding = new Map<string, Promise<unknown>>();

  function warmSheet(url: string) {
    let pending = decoding.get(url);
    if (!pending) {
      const img = new Image();
      img.src = url;
      pending = img.decode().catch(() => {});
      decoding.set(url, pending);
    }
    return pending;
  }

  async function updateMemojiImage() {
    const next = `url("${sheetFor(localStorage.getItem("theme"))}")`;
    const root = document.documentElement;
    if (root.style.getPropertyValue("--memoji-sheet") === next) return;

    await warmSheet(sheetFor(localStorage.getItem("theme")));
    root.style.setProperty("--memoji-sheet", next);
  }

  function prewarmOnThemeHover() {
    document.querySelectorAll<HTMLElement>(".theme-btn").forEach((btn) => {
      btn.addEventListener(
        "pointerenter",
        () => warmSheet(sheetFor(btn.dataset.theme ?? null)),
        { once: true },
      );
    });
  }

  function initPointerSpin() {
    const avatar = document.getElementById("memoji-avatar");
    const area = document.getElementById("memoji-spin-area");
    if (!avatar || !area) return;

    const duration =
      parseFloat(
        getComputedStyle(avatar).getPropertyValue("--sprite-duration"),
      ) * 1000;
    let frame = 0;
    let lastX = 0;
    let travel = 0;

    const liveFrame = () => {
      const spin = avatar
        .getAnimations()
        .find((a) => (a as CSSAnimation).animationName === "avatar-sprite-row");
      const progress = spin?.effect?.getComputedTiming().progress;
      return progress == null
        ? frame
        : Math.floor(progress * SPRITE.FRAMES) % SPRITE.FRAMES;
    };

    area.addEventListener("pointerenter", (event) => {
      lastX = event.clientX;
      travel = 0;
      frame = liveFrame();
      avatar.classList.add("is-manual");
      avatar.style.backgroundPosition = cellPosition(frame);
    });

    area.addEventListener("pointermove", (event) => {
      if (!avatar.classList.contains("is-manual")) return;
      travel += event.clientX - lastX;
      lastX = event.clientX;

      const steps = Math.trunc(travel / PX_PER_FRAME);
      if (!steps) return;
      travel -= steps * PX_PER_FRAME;
      frame =
        (((frame + steps) % SPRITE.FRAMES) + SPRITE.FRAMES) % SPRITE.FRAMES;
      avatar.style.backgroundPosition = cellPosition(frame);
    });

    area.addEventListener("pointerdown", (event) => {
      area.setPointerCapture(event.pointerId);
    });

    area.addEventListener("pointerleave", () => {
      avatar.classList.remove("is-manual");
      avatar.style.backgroundPosition = "";
      avatar.style.animationDelay = `-${(frame / SPRITE.FRAMES) * duration}ms`;
    });
  }

  const observer = new MutationObserver((mutations) => {
    if (mutations.some((mutation) => mutation.attributeName === "class")) {
      updateMemojiImage();
    }
  });

  document.addEventListener("astro:page-load", () => {
    updateMemojiImage();
    initPointerSpin();
    prewarmOnThemeHover();
    observer.observe(document.body, {
      attributes: true,
      attributeFilter: ["class"],
    });
  });

  document.addEventListener("astro:before-swap", () => observer.disconnect());
  document.addEventListener("themechange", updateMemojiImage);
</script>
