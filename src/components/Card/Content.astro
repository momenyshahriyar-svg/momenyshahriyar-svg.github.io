---
interface Props {
  title?: string;
  titleFa?: string;
}

const { title, titleFa } = Astro.props;
---

<>
  {
    title && (
      <h2 class="text-xl font-bold m-0 z-20">
        {titleFa ? (
          <>
            <span class="lang-en">{title}</span>
            <span class="lang-fa">{titleFa}</span>
          </>
        ) : (
          title
        )}
      </h2>
    )
  }
  <slot />
</>
